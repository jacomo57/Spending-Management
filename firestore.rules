rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite codes. The document id is the code. Only the project owner adds or
    // deletes them (Firebase console); the app can never read, list or change them.
    // Delete the codes once both accounts exist and sign-ups are closed.
    match /invites/{code} {
      allow read, write: if false;
    }

    // One profile document per account. It can only be created by its own user,
    // and only with an invite code that exists. Everything else hangs off it.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['invite', 'created'])
        && request.resource.data.invite is string
        && request.resource.data.invite.size() > 0
        && request.resource.data.invite.size() < 200
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite));
      allow delete: if request.auth != null && request.auth.uid == uid;

      // The account's data: data/settings and months/{YYYY-MM}.
      // Only the owner, and only once the profile (so a valid invite) exists.
      // (Named collections on purpose: a {name=**} wildcard would also match the profile itself.)
      function ownerWithProfile() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(uid));
      }
      // Every data document is {v: 1, json: "<text>"} and nothing else. Firestore's own limit is 1 MiB per document.
      function validDoc() {
        return request.resource.data.keys().hasOnly(['v', 'json'])
          && request.resource.data.v == 1
          && request.resource.data.json is string
          && request.resource.data.json.size() < 900000;
      }
      match /data/{doc} {
        allow read, delete: if ownerWithProfile();
        allow create, update: if ownerWithProfile() && doc == 'settings' && validDoc();
        // data/phone holds the phone key: {key: "<20 to 100 characters>"}. Only the owner can read or change it.
        allow create, update: if ownerWithProfile() && doc == 'phone'
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 20 && request.resource.data.key.size() <= 100;
      }
      // Phone inbox: a phone automation adds an expense here WITHOUT signing in, by sending the phone key.
      // It can only create a small document of short texts; it can never read, list, change or delete anything.
      // The owner's app reads the inbox, turns each item into a purchase and deletes it. No key document = inbox closed.
      function shortText(k, n) {
        return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n);
      }
      match /inbox/{id} {
        allow read, delete: if ownerWithProfile();
        allow create: if request.resource.data.keys().hasOnly(['key', 'amt', 'desc', 'card', 'date', 'title', 'text'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 20 && request.resource.data.key.size() <= 100
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)/data/phone).data.key == request.resource.data.key
          && shortText('amt', 40) && shortText('desc', 200) && shortText('card', 60) && shortText('date', 40)
          && shortText('title', 200) && shortText('text', 500);
      }
      // A month is named YYYY-MM; "none" holds rows without a date (the app's mk() in cloud.js).
      match /months/{doc} {
        allow read, delete: if ownerWithProfile();
        allow create, update: if ownerWithProfile() && doc.matches('^([0-9]{4}-[0-9]{2}|none)$') && validDoc();
      }
    }
  }
}
