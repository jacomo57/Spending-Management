{
  "name": "Spend, sorted",
  "short_name": "Spend",
  "description": "Personal spending tracker",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0E1626",
  "theme_color": "#0E1626",
  "user_preferences": {
    "color_scheme_light": { "background_color": "#EEF3FC", "theme_color": "#EEF3FC" },
    "color_scheme_dark": { "background_color": "#0E1626", "theme_color": "#0E1626" }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
